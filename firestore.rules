rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable primitive guards
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation blueprint for public non-PII leaderboard entries
    function isValidLeaderboardScore(data) {
      return data.keys().hasAll([
        'uid',
        'playerName',
        'score',
        'snakeLength',
        'obstaclesCleared',
        'difficulty',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'playerName',
        'score',
        'snakeLength',
        'obstaclesCleared',
        'difficulty',
        'createdAt'
      ])
      && data.uid is string
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && data.playerName is string
      && data.playerName.size() >= 1
      && data.playerName.size() <= 32
      && data.score is int
      && data.score >= 0
      && data.score <= 10000000
      && data.snakeLength is int
      && data.snakeLength >= 3
      && data.snakeLength <= 5000
      && data.obstaclesCleared is int
      && data.obstaclesCleared >= 0
      && data.obstaclesCleared <= 100000
      && data.difficulty in ['classic', 'chaos', 'overdrive']
      && data.createdAt is timestamp;
    }

    // Validation blueprint for owner-restricted user profiles
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'email',
        'bestScore',
        'bestLength',
        'runsPlayed',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'bestScore',
        'bestLength',
        'runsPlayed',
        'createdAt',
        'updatedAt'
      ])
      && data.uid is string
      && isValidId(data.uid)
      && data.uid == userId
      && data.displayName is string
      && data.displayName.size() >= 1
      && data.displayName.size() <= 64
      && data.email is string
      && data.email.size() >= 3
      && data.email.size() <= 128
      && data.bestScore is int
      && data.bestScore >= 0
      && data.bestScore <= 10000000
      && data.bestLength is int
      && data.bestLength >= 3
      && data.bestLength <= 5000
      && data.runsPlayed is int
      && data.runsPlayed >= 0
      && data.runsPlayed <= 1000000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // Public global high-score leaderboard (immutable run records, zero PII)
    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId) && existing().score >= 0;
      allow list: if resource.data.score >= 0;
      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && isValidLeaderboardScore(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(entryId)
        && existing().uid == request.auth.uid;
    }

    // Private owner-only user profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'bestScore',
          'bestLength',
          'runsPlayed',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
